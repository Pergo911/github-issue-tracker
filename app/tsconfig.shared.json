{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild/shared",
    "tsBuildInfoFile": ".tsbuild/shared.tsbuildinfo",
    "lib": ["ES2023"],
    "types": [],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/shared/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
