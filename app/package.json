{
  "name": "fault-reports-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The reporter, staff and admin SPA and its Cloudflare Worker: one Vite project, one Deployment unit (SPEC 2.6).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.ts",
    "preview": "vite preview",
    "types": "wrangler types --strict-vars false",
    "typecheck": "npm run --silent types && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:tooling": "vitest run --project tooling",
    "test:e2e": "node scripts/e2e.ts",
    "seed": "node scripts/seed.ts",
    "reset": "node scripts/reset.ts",
    "world": "node scripts/world.ts",
    "recovery": "node scripts/recovery.ts",
    "screenshots": "node scripts/screenshots.ts",
    "test:visual": "node scripts/visual.ts",
    "test:visual:update": "node scripts/visual.ts --update",
    "verify": "node scripts/verify.ts",
    "setup": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@hono/standard-validator": "0.4.1",
    "@primer/octicons-react": "19.42.0",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@eslint/js": "10.0.1",
    "@octokit/openapi-types": "29.0.1",
    "@octokit/types": "18.0.0",
    "@playwright/test": "1.65.0",
    "@primer/primitives": "11.10.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/rule-tester": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true
  }
}
