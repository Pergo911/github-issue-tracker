{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild/e2e",
    "tsBuildInfoFile": ".tsbuild/e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["playwright.config.ts", "e2e/**/*"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
