{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild/test-worker",
    "tsBuildInfoFile": ".tsbuild/test-worker.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["@cloudflare/vitest-plugin/types"],
    "paths": {
      "@worker/*": ["./src/worker/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/worker/**/*.test.ts", "worker-configuration.d.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }, { "path": "./tsconfig.worker.json" }]
}
