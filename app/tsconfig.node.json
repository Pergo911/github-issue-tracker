{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild/node",
    "tsBuildInfoFile": ".tsbuild/node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "eslint-rules/**/*.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
